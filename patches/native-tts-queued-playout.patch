+import { beforeEach, describe, expect, test, vi } from 'vitest';
+
+const fetchMock = vi.fn();
+vi.mock('@/services/ai/utils/httpFetch', () => ({ getAIFetch: () => fetchMock }));
+
+import {
+  buildTemplateRequest,
+  getByPath,
+  renderTemplate,
+  synthesizeWithTemplate,
+  type TemplateContext,
+} from '@/services/tts/providers/template';
+import {
+  SpeechSynthesisFatalError,
+  SpeechSynthesisPermanentError,
+} from '@/services/tts/providers/types';
+import type { CustomTTSService } from '@/types/customTTS';
+
+const ctx: TemplateContext = {
+  text: '他说："你好"',
+  voice: 'male-qn-qingse',
+  lang: 'zh-CN',
+  rate: 1,
+  pitch: 1,
+  format: 'mp3',
+  apiKey: 'secret key',
+  baseUrl: 'https://api.example.com',
+};
+
+const minimax = (): CustomTTSService => ({
+  id: 'mm',
+  name: 'MiniMax',
+  baseUrl: 'https://api.minimaxi.com',
+  apiKey: 'k',
+  model: 'speech-02-hd',
+  kind: 'template',
+  addedAt: 0,
+  updatedAt: 0,
+  request: {
+    method: 'POST',
+    url: '{{baseUrl}}/v1/t2a_v2',
+    headers: { Authorization: 'Bearer {{apiKey}}', 'Content-Type': 'application/json' },
+    bodyType: 'json',
+    body: '{"text":{{text}},"voice_setting":{"voice_id":{{voice}}}}',
+    responseType: 'json',
+    audioPath: 'data.audio',
+    audioEncoding: 'hex',
+    successPath: 'base_resp.status_code',
+    successValue: '0',
+    errorPath: 'base_resp.status_msg',
+  },
+});
+
+const jsonResponse = (body: unknown, status = 200) => ({
+  ok: status >= 200 && status < 300,
+  status,
+  text: async () => JSON.stringify(body),
+  arrayBuffer: async () => new ArrayBuffer(0),
+});
+
+beforeEach(() => {
+  fetchMock.mockReset();
+});
+
+describe('renderTemplate', () => {
+  test('quotes values in JSON so an embedded quote cannot break the body', () => {
+    const body = renderTemplate('{"text":{{text}}}', ctx, 'json');
+    expect(body).toBe(`{"text":${JSON.stringify(ctx.text)}}`);
+    expect(() => JSON.parse(body)).not.toThrow();
+  });
+
+  test('encodes values in a URL', () => {
+    expect(renderTemplate('{{baseUrl}}/tts?t={{text}}', ctx, 'url')).toBe(
+      `https://api.example.com/tts?t=${encodeURIComponent(ctx.text)}`,
+    );
+  });
+
+  test('writes numbers bare, so rate never arrives as a string', () => {
+    expect(renderTemplate('{"rate":{{rate}}}', ctx, 'json')).toBe('{"rate":1}');
+  });
+
+  test('unknown placeholders collapse instead of leaving braces behind', () => {
+    expect(renderTemplate('a{{nope}}b', ctx, 'raw')).toBe('ab');
+  });
+});
+
+describe('getByPath', () => {
+  test('walks objects and arrays', () => {
+    const body = { choices: [{ message: { audio: { data: 'x' } } }] };
+    expect(getByPath(body, 'choices.0.message.audio.data')).toBe('x');
+    expect(getByPath(body, 'choices.1')).toBeUndefined();
+    expect(getByPath(body, '')).toBeUndefined();
+  });
+});
+
+describe('buildTemplateRequest', () => {
+  test('fills the url, the headers and the body from one context', () => {
+    const { url, headers, body } = buildTemplateRequest(
+      minimax(),
+      { lang: 'zh-CN', text: '你好', voice: 'male-qn-qingse', pitch: 1 },
+      ctx,
+    );
+    expect(url).toBe('https://api.minimaxi.com/v1/t2a_v2');
+    expect(headers.Authorization).toBe('Bearer k');
+    expect(JSON.parse(body!)).toEqual({
+      text: '你好',
+      voice_setting: { voice_id: 'male-qn-qingse' },
+    });
+  });
+});
+
+describe('synthesizeWithTemplate', () => {
+  const request = { lang: 'zh-CN', text: '你好', voice: 'male-qn-qingse', pitch: 1 };
+
+  test('decodes a hex audio field out of a JSON response', async () => {
+    fetchMock.mockResolvedValue(
+      jsonResponse({ base_resp: { status_code: 0 }, data: { audio: '48656c6c6f' } }),
+    );
+    const audio = await synthesizeWithTemplate(minimax(), request, new AbortController().signal);
+    expect(new TextDecoder().decode(audio)).toBe('Hello');
+  });
+
+  test('a failure reported inside HTTP 200 is still an error, with the vendor message', async () => {
+    fetchMock.mockResolvedValue(
+      jsonResponse({ base_resp: { status_code: 1004, status_msg: 'login fail' } }),
+    );
+    const error = await synthesizeWithTemplate(
+      minimax(),
+      request,
+      new AbortController().signal,
+    ).catch((e: unknown) => e);
+    expect(error).toBeInstanceOf(SpeechSynthesisPermanentError);
+    expect(String((error as Error).message)).toContain('login fail');
+  });
+
+  test('missing audio at the configured path names the path', async () => {
+    fetchMock.mockResolvedValue(jsonResponse({ base_resp: { status_code: 0 }, data: {} }));
+    const error = await synthesizeWithTemplate(
+      minimax(),
+      request,
+      new AbortController().signal,
+    ).catch((e: unknown) => e);
+    expect(value(error)).toContain('data.audio');
+  });
+
+  test('a rejected key is fatal, not a sentence-level failure', async () => {
+    fetchMock.mockResolvedValue({
+      ok: false,
+      status: 401,
+      text: async () => 'nope',
+      arrayBuffer: async () => new ArrayBuffer(0),
+    });
+    await expect(
+      synthesizeWithTemplate(minimax(), request, new AbortController().signal),
+    ).rejects.toBeInstanceOf(SpeechSynthesisFatalError);
+  });
+
+  test('a raw-audio response is handed back as bytes, not as text', async () => {
+    const bytes = new Uint8Array([0xff, 0xfb, 0x90, 0x64]);
+    const service = minimax();
+    service.request = {
+      method: 'POST',
+      url: '{{baseUrl}}/v1/audio',
+      headers: {},
+      bodyType: 'json',
+      body: '{"text":{{text}}}',
+      responseType: 'audio',
+    };
+    fetchMock.mockResolvedValue({
+      ok: true,
+      status: 200,
+      text: async () => '',
+      arrayBuffer: async () => bytes.buffer,
+    });
+    const audio = await synthesizeWithTemplate(service, request, new AbortController().signal);
+    expect(new Uint8Array(audio)).toEqual(bytes);
+  });
+});
+
+const value = (error: unknown): string => String((error as Error)?.message ?? '');
