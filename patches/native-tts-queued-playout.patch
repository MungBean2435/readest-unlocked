 import { notifyCarPlayState } from './carPlaySession';
 import { SILENCE_DATA } from './TTSData';
+import { ttsLatencyReport } from './ttsMetrics';
 import { resumePlayback, type PlaybackSource } from '@/services/playback/playbackSource';
 import type { TTSMark, TTSMediaMetadataMode } from './types';
 
@@ -98,6 +99,13 @@ export const releaseUnblockAudio = (): void => {
 
 type BridgeMediaSession = TauriMediaSession | MediaSession;
 
+// MEASUREMENT BUILD: `title · p50/p95 ms · n` while a session is being measured.
+const withLatency = (title: string): string => {
+  const report = ttsLatencyReport();
+  if (report.sentences < 5) return title;
+  return `${title} · ${report.gapMs.p50}/${report.gapMs.p95}ms n=${report.sentences}`;
+};
