diff --git a/apps/readest-app/src/__tests__/services/native-tts-queue.test.ts b/apps/readest-app/src/__tests__/services/native-tts-queue.test.ts
new file mode 100644
index 0000000..cc2c4dc
--- /dev/null
+++ b/apps/readest-app/src/__tests__/services/native-tts-queue.test.ts
@@ -0,0 +1,159 @@
+import { describe, test, expect, vi, beforeEach } from 'vitest';
+
+type EventHandler = (event: unknown) => void;
+let emit: EventHandler | null = null;
+
+vi.mock('@tauri-apps/api/core', () => ({
+  invoke: vi.fn(),
+  addPluginListener: vi.fn(async (_plugin: string, _event: string, handler: EventHandler) => {
+    emit = handler;
+    return { unregister: vi.fn() };
+  }),
+}));
+
+// Avoid pulling in the heavy TTSController module graph (foliate-js, etc.) — the
+// native client only uses it to dispatch marks.
+vi.mock('@/services/tts/TTSController', () => ({ TTSController: class {} }));
+
+import { NativeTTSClient } from '@/services/tts/NativeTTSClient';
+import { invoke } from '@tauri-apps/api/core';
+
+const SSML = `<speak xml:lang="en"><mark name="m1"/>First sentence. <mark name="m2"/>Second sentence. <mark name="m3"/>Third sentence. <mark name="m4"/>Fourth sentence.</speak>`;
+
+interface SpeakPayload {
+  text: string;
+  preload: boolean;
+  mode: string;
+}
+
+const speakPayloads: SpeakPayload[] = [];
+let utteranceSeq = 0;
+
+const tick = async (rounds = 20) => {
+  for (let i = 0; i < rounds; i++) await new Promise((resolve) => setTimeout(resolve, 0));
+};
+
+const startSpeaking = (client: NativeTTSClient, ssml = SSML) => {
+  const controller = new AbortController();
+  const events: { code: string; mark?: string }[] = [];
+  const done = (async () => {
+    for await (const event of client.speak(ssml, controller.signal)) {
+      events.push(event);
+    }
+  })();
+  return { controller, events, done };
+};
+
+const fire = (utteranceId: string, code: string, message?: string) => {
+  emit?.({ utteranceId, code, message });
+};
+
+const createClient = async (ttsController?: unknown) => {
+  const client = new NativeTTSClient(ttsController as never);
+  client.setPrimaryLang('en');
+  await client.init();
+  return client;
+};
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  emit = null;
+  speakPayloads.length = 0;
+  utteranceSeq = 0;
+  vi.mocked(invoke).mockImplementation(async (cmd: string, args?: unknown) => {
+    if (cmd === 'plugin:native-tts|init') return { success: true };
+    if (cmd === 'plugin:native-tts|get_all_voices') {
+      return { voices: [{ id: 'voice-1', name: 'Voice 1', lang: 'en-US' }] };
+    }
+    if (cmd === 'plugin:native-tts|speak') {
+      speakPayloads.push((args as { payload: SpeakPayload }).payload);
+      return { utteranceId: `u${++utteranceSeq}` };
+    }
+    return undefined;
+  });
+});
+
+describe('NativeTTSClient queued playout', () => {
+  test('submits sentences into the engine queue before the first one finishes', async () => {
+    const client = await createClient();
+    startSpeaking(client);
+    await tick();
+
+    // Three sentences in hand, and only the first one flushes.
+    expect(speakPayloads.map((payload) => payload.mode)).toEqual(['flush', 'queue', 'queue']);
+    expect(speakPayloads.map((payload) => payload.text.trim())).toEqual([
+      'First sentence.',
+      'Second sentence.',
+      'Third sentence.',
+    ]);
+  });
+
+  test('dispatches a mark when its audio starts, not when it is queued', async () => {
+    const dispatchSpeakMark = vi.fn();
+    const client = await createClient({ dispatchSpeakMark });
+    startSpeaking(client);
+    await tick();
+
+    // Queued ahead, but nothing audible yet.
+    expect(speakPayloads).toHaveLength(3);
+    expect(dispatchSpeakMark).not.toHaveBeenCalled();
+
+    fire('u1', 'boundary', 'start');
+    expect(dispatchSpeakMark).toHaveBeenCalledTimes(1);
+    expect(dispatchSpeakMark.mock.calls[0]![0]).toMatchObject({ name: 'm1' });
+
+    fire('u1', 'end');
+    await tick();
+    fire('u2', 'boundary', 'start');
+    expect(dispatchSpeakMark).toHaveBeenCalledTimes(2);
+    expect(dispatchSpeakMark.mock.calls[1]![0]).toMatchObject({ name: 'm2' });
+  });
+
+  test('yields events in reading order even when a later sentence finishes first', async () => {
+    const client = await createClient();
+    const { controller, events, done } = startSpeaking(client);
+    await tick();
+
+    // The engine can report the second sentence before the first one is done.
+    fire('u2', 'end');
+    fire('u1', 'boundary', 'start');
+    fire('u1', 'end');
+    await tick();
+
+    expect(events.map((event) => `${event.code}:${event.mark}`)).toEqual([
+      'boundary:m1',
+      'end:m1',
+      'end:m2',
+    ]);
+
+    controller.abort();
+    await done;
+  });
+
+  test('tops the queue up as sentences finish and ends after the last one', async () => {
+    const client = await createClient();
+    const { events, done } = startSpeaking(client);
+    await tick();
+
+    for (let index = 1; index <= 4; index++) {
+      fire(`u${index}`, 'boundary', 'start');
+      fire(`u${index}`, 'end');
+      await tick();
+    }
+
+    await done;
+    expect(speakPayloads).toHaveLength(4);
+    expect(events.filter((event) => event.code === 'end')).toHaveLength(4);
+  });
+
+  test('stops without waiting when the signal is aborted', async () => {
+    const client = await createClient();
+    const { controller, events, done } = startSpeaking(client);
+    await tick();
+
+    controller.abort();
+    await done;
+
+    expect(events.at(-1)?.code).toBe('error');
+  });
+});
diff --git a/apps/readest-app/src/__tests__/services/tts-metrics.test.ts b/apps/readest-app/src/__tests__/services/tts-metrics.test.ts
new file mode 100644
