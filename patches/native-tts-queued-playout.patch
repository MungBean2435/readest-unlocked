--- /dev/null
+++ b/apps/readest-app/src/__tests__/services/tts-metrics.test.ts
@@ -0,0 +1,48 @@
+import { beforeEach, describe, expect, test } from 'vitest';
+
+import {
+  noteSentenceEnded,
+  noteSentenceStarted,
+  resetTTSLatency,
+  ttsLatencyReport,
+} from '@/services/tts/ttsMetrics';
+
+describe('ttsLatencyReport', () => {
+  beforeEach(() => {
+    resetTTSLatency();
+  });
+
+  test('reports the submit-to-start delay and the audible gap between sentences', () => {
+    // Sentence 1 submitted at 0, audible at 200: 200 ms of start latency.
+    noteSentenceStarted(0, 200);
+    noteSentenceEnded(1000);
+    // Sentence 2 submitted at 1010, audible at 1150: the gap is 150 ms.
+    noteSentenceStarted(1010, 1150);
+    noteSentenceEnded(2000);
+    noteSentenceStarted(2010, 2200);
+
+    const report = ttsLatencyReport();
+    expect(report.sentences).toBe(3);
+    expect(report.startDelayMs.p50).toBeGreaterThan(0);
+    expect(report.gapMs.max).toBe(200);
+    expect(report.dispatchMs.max).toBe(10);
+  });
+
+  test('ignores pauses longer than the cadence window', () => {
+    noteSentenceStarted(0, 100);
+    noteSentenceEnded(1000);
+    // A 30 s pause (user hit pause, or a chapter break) is not a sentence gap.
+    noteSentenceStarted(30000, 30100);
+
+    expect(ttsLatencyReport().gapMs.max).toBe(0);
+  });
+
+  test('keeps samples from before a reset out of the report', () => {
+    noteSentenceStarted(0, 500);
+    noteSentenceEnded(1000);
+    expect(ttsLatencyReport().sentences).toBe(1);
+
+    resetTTSLatency();
+    expect(ttsLatencyReport().sentences).toBe(0);
+  });
+});
