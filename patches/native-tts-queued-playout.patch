+const firstArray = (value: unknown): unknown[] => {
+  if (Array.isArray(value)) return value;
+  if (value && typeof value === 'object') {
+    for (const entry of Object.values(value)) {
+      if (Array.isArray(entry)) return entry;
+    }
+  }
+  return [];
