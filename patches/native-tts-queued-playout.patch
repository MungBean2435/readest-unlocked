+    const provider = buildProvider(service());
+    const request = {
+      lang: 'zh-CN',
+      text: '你好',
+      voice: 'az:zh-CN-XiaoxiaoMultilingualNeural',
+    };
+
+    fetchMock.mockResolvedValueOnce(response({ ok: false, status: 401, body: 'denied' }));
+    await expect(provider.synthesize(request, new AbortController().signal)).rejects.toBeInstanceOf(
