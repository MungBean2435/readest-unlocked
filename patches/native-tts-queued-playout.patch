new file mode 100644
index 0000000..a95af8b
--- /dev/null
+++ b/apps/readest-app/src/services/tts/ttsMetrics.ts
@@ -0,0 +1,108 @@
+// Latency bookkeeping for read-aloud, measured where the silence actually
+// happens: between one sentence ending and the next one becoming audible.
+//
+// M0 of the native-TTS low-latency work: before the pipeline changes anything,
+// this records what the current direct-speak path costs per sentence, so the
+// before/after numbers come from the same definition.
+//
+// Enabled by `localStorage['tts-latency-metrics'] = '1'` (or
+// `globalThis.__ttsLatency = true`). Samples are kept in memory only: reading
+// them twice must not require a round trip through the settings UI.
+// `globalThis.ttsLatencyReport()` returns the summary at any time.
+
+export interface TTSPercentiles {
+  p50: number;
+  p95: number;
+  max: number;
+}
+
+export interface TTSLatencyReport {
+  sentences: number;
+  // invoke('speak') -> the engine reporting that it started this sentence.
+  startDelayMs: TTSPercentiles;
+  // end of sentence N -> start of sentence N+1, i.e. the audible dead air.
+  gapMs: TTSPercentiles;
+  // Gap between the JS learning a sentence ended and the next submission, the
+  // part of the gap the pipeline can remove without touching the engine.
+  dispatchMs: TTSPercentiles;
+}
+
+const MAX_SAMPLES = 500;
+// A gap longer than this is a pause, a seek or a chapter break, not sentence
+// cadence; counting it would swamp the percentile that matters.
+const MAX_GAP_MS = 5000;
+const LOG_EVERY = 20;
+
+const startDelays: number[] = [];
+const gaps: number[] = [];
+const dispatches: number[] = [];
+
+let lastEndedAt: number | null = null;
+
+export const ttsMetricsEnabled = (): boolean => {
+  if ((globalThis as { __ttsLatency?: boolean }).__ttsLatency === true) return true;
+  try {
+    return globalThis.localStorage?.getItem('tts-latency-metrics') === '1';
+  } catch {
+    return false;
+  }
+};
+
+const clear = (): void => {
+  startDelays.length = 0;
+  gaps.length = 0;
+  dispatches.length = 0;
+  lastEndedAt = null;
+};
+
+const push = (list: number[], value: number): void => {
+  if (!Number.isFinite(value) || value < 0) return;
+  list.push(value);
+  if (list.length > MAX_SAMPLES) list.shift();
+};
+
+const percentile = (values: number[], p: number): number => {
+  if (values.length === 0) return 0;
+  const sorted = [...values].sort((a, b) => a - b);
+  const index = Math.min(sorted.length - 1, Math.floor((p / 100) * sorted.length));
+  return Math.round(sorted[index] ?? 0);
+};
+
+const summarize = (values: number[]): TTSPercentiles => ({
+  p50: percentile(values, 50),
+  p95: percentile(values, 95),
+  max: values.length ? Math.round(Math.max(...values)) : 0,
+});
+
+export const ttsLatencyReport = (): TTSLatencyReport => ({
+  sentences: startDelays.length,
+  startDelayMs: summarize(startDelays),
+  gapMs: summarize(gaps),
+  dispatchMs: summarize(dispatches),
+});
+
+// The engine reported this sentence audible at `startedAt`.
+export const noteSentenceStarted = (submittedAt: number, startedAt: number): void => {
+  push(startDelays, startedAt - submittedAt);
+  if (lastEndedAt !== null && startedAt > lastEndedAt) {
+    const gap = startedAt - lastEndedAt;
+    if (gap <= MAX_GAP_MS) push(gaps, gap);
+  }
+  // Only the cadence case: a pause or a chapter break is not JS overhead.
+  if (lastEndedAt !== null && startedAt - lastEndedAt <= MAX_GAP_MS) {
+    push(dispatches, submittedAt - lastEndedAt);
+  }
+};
+
+// The engine reported this sentence finished (or failed) at `endedAt`.
+export const noteSentenceEnded = (endedAt: number = Date.now()): void => {
+  lastEndedAt = endedAt;
+  if (ttsMetricsEnabled() && startDelays.length > 0 && startDelays.length % LOG_EVERY === 0) {
+    console.info('[TTS latency]', JSON.stringify(ttsLatencyReport()));
+  }
+};
+
+export const resetTTSLatency = (): void => clear();
+
+(globalThis as { ttsLatencyReport?: () => TTSLatencyReport }).ttsLatencyReport = ttsLatencyReport;
+(globalThis as { resetTTSLatency?: () => void }).resetTTSLatency = resetTTSLatency;
