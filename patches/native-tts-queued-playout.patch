+  // the picker to the kind of model this service actually speaks with.
+  let keep: RegExp | null = null;
+  if (list.filter) {
+    try {
+      keep = new RegExp(list.filter, 'i');
+    } catch {
+      keep = null;
+    }
+  }
+
   return items.flatMap((item) => {
     const id = getByPath(item, list.idPath);
     if (typeof id !== 'string' || !id) return [];
+    if (keep && !keep.test(id)) return [];
     const name = list.namePath ? getByPath(item, list.namePath) : undefined;
     const locale = list.localePath ? getByPath(item, list.localePath) : undefined;
     const label = typeof name === 'string' && name && name !== id ? name : undefined;
