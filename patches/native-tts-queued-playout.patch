+
+/** The voices a templated service lists, when its template says how to ask. */
+export const fetchTemplateVoices = async (
+  service: CustomTTSService,
+): Promise<{ name: string; label?: string; lang?: string }[]> => {
+  const list = service.request?.voiceList;
+  if (!list) return [];
+  const ctx: TemplateContext = {
+    text: '',
+    voice: '',
+    lang: '',
+    model: service.model,
+    rate: 1,
+    pitch: 1,
+    format: service.responseFormat ?? 'mp3',
+    apiKey: service.apiKey ?? '',
+    baseUrl: service.baseUrl,
+  };
+  const url = renderTemplate(list.url, ctx, 'url');
+  const headers: Record<string, string> = {};
+  for (const [key, value] of Object.entries(list.headers ?? {})) {
+    if (value) headers[key] = renderTemplate(value, ctx, 'raw');
+  }
+  const res = await getAIFetch()(url, { headers });
+  if (!res.ok) return [];
+  const body: unknown = await res.json();
+  const items = list.itemsPath ? (getByPath(body, list.itemsPath) as unknown[]) : firstArray(body);
+  if (!Array.isArray(items)) return [];
+
+  return items.flatMap((item) => {
+    const id = getByPath(item, list.idPath);
+    if (typeof id !== 'string' || !id) return [];
+    const name = list.namePath ? getByPath(item, list.namePath) : undefined;
+    const locale = list.localePath ? getByPath(item, list.localePath) : undefined;
+    const label = typeof name === 'string' && name ? name : undefined;
+    return [
+      {
+        // `name` is what the request needs; `label` is what the picker shows.
+        name: id,
+        ...(label && label !== id ? { label } : {}),
+        ...(typeof locale === 'string' && locale ? { lang: locale } : {}),
+      },
+    ];
+  });
+};
