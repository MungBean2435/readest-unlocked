+    expect(init.method).toBe('POST');
+    expect(init.headers['Ocp-Apim-Subscription-Key']).toBe('azure-key');
+    expect(init.headers.Authorization).toBeUndefined();
+    expect(init.headers['X-Microsoft-OutputFormat']).toBe('audio-24khz-48kbitrate-mp3');
+    expect(init.body).toContain('<voice name="zh-CN-XiaoxiaoMultilingualNeural">');
+    // The text is escaped, not interpolated: an ampersand would break the SSML.
+    expect(init.body).toContain('&#38;');
+    expect(init.body).toContain('&#60;测试&#62;');
+  });
+
