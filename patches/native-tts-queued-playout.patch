+  test('lists the voices Azure serves, with their locales', async () => {
+    fetchMock.mockResolvedValue(
+      response({
+        body: [
+          { ShortName: 'zh-CN-XiaoxiaoMultilingualNeural', Locale: 'zh-CN', VoiceType: 'Neural' },
+          { ShortName: 'zh-CN-XiaochenMultilingualNeural', Locale: 'zh-CN', VoiceType: 'Neural' },
+          { ShortName: 'en-US-AvaMultilingualNeural', Locale: 'en-US', VoiceType: 'Neural' },
+        ],
+      }),
+    );
+    const provider = buildProvider(service({ voices: undefined }));
+
+    const voices = await provider.getAllVoices();
+    expect(fetchMock.mock.calls[0]![0]).toBe(
+      'https://eastasia.tts.speech.microsoft.com/cognitiveservices/voices/list',
+    );
+    expect(voices.map((voice) => voice.id)).toEqual([
+      'az:zh-CN-XiaoxiaoMultilingualNeural',
+      'az:zh-CN-XiaochenMultilingualNeural',
+      'az:en-US-AvaMultilingualNeural',
+    ]);
+    expect(voices[0]!.lang).toBe('zh-CN');
+  });
+});
