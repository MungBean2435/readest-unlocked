new file mode 100644
index 0000000..68f2108
--- /dev/null
+++ b/apps/readest-app/src/services/tts/providers/template.ts
@@ -0,0 +1,235 @@
+// A user-authored HTTP request, so a speech service does not need an adapter of
+// its own in the app. Vendors disagree on almost everything — the endpoint, the
+// auth header, the body shape, the response envelope and the audio encoding
+// (MiniMax answers HTTP 200 with the error inside the body and returns hex, for
+// instance) — and a template covers all of it without shipping code per vendor.
+
+import { getAIFetch } from '@/services/ai/utils/httpFetch';
+import type { CustomTTSService, TTSRequestTemplate } from '@/types/customTTS';
+
+import {
+  type SpeechSynthesisRequest,
+  SpeechSynthesisFatalError,
+  SpeechSynthesisPermanentError,
+} from './types';
+
+export interface TemplateContext {
+  text: string;
+  voice: string;
+  lang: string;
+  rate: number;
+  pitch: number;
+  format: string;
+  apiKey: string;
+  baseUrl: string;
+}
+
+const PLACEHOLDER = /\{\{\s*([a-zA-Z][a-zA-Z0-9_]*)\s*\}\}/g;
+
+// Values that are numbers in the payload, so `{{rate}}` does not arrive quoted.
+const NUMERIC = new Set(['rate', 'pitch']);
+
+const placeholderValue = (ctx: TemplateContext, key: string): string | number | undefined => {
+  if (key in ctx) return ctx[key as keyof TemplateContext];
+  return undefined;
+};
+
+/**
+ * Render a template string.
+ *
+ * `json` quotes string values for you (write `"text": {{text}}`), `url` encodes
+ * them, and `raw` inserts them untouched (headers, form bodies the author has
+ * already encoded).
+ */
+export const renderTemplate = (
+  template: string,
+  ctx: TemplateContext,
+  mode: 'json' | 'url' | 'raw',
+): string =>
+  template.replace(PLACEHOLDER, (_match, key: string) => {
+    const value = placeholderValue(ctx, key);
+    if (value === undefined) return '';
+    // The base URL is a URL, not a component of one: encoding it would turn
+    // "https://host" into a path segment.
+    if (mode === 'url')
+      return key === 'baseUrl' ? String(value) : encodeURIComponent(String(value));
+    if (mode === 'raw') return String(value);
+    if (typeof value === 'number' || NUMERIC.has(key)) return String(value);
+    return JSON.stringify(String(value));
+  });
+
+/** Dotted path lookup with numeric segments: `choices.0.message.audio`. */
+export const getByPath = (value: unknown, path: string): unknown => {
+  if (!path) return undefined;
+  let current: unknown = value;
+  for (const segment of path.split('.')) {
+    if (current === null || current === undefined) return undefined;
+    if (Array.isArray(current)) {
+      const index = Number(segment);
+      current = Number.isInteger(index) ? current[index] : undefined;
+      continue;
+    }
+    if (typeof current !== 'object') return undefined;
+    current = (current as Record<string, unknown>)[segment];
+  }
+  return current;
+};
+
+const hexToBytes = (hex: string): Uint8Array => {
+  const clean = hex.trim().replace(/^0x/i, '');
+  const bytes = new Uint8Array(Math.floor(clean.length / 2));
+  for (let i = 0; i < bytes.length; i++) {
+    bytes[i] = parseInt(clean.slice(i * 2, i * 2 + 2), 16);
+  }
+  return bytes;
+};
+
+const base64ToBytes = (value: string): Uint8Array => {
+  const binary = atob(value);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
+  return bytes;
+};
+
+const bytesOf = (value: string, encoding: TTSRequestTemplate['audioEncoding']): ArrayBuffer => {
+  switch (encoding) {
+    case 'hex':
+      return hexToBytes(value).buffer as ArrayBuffer;
+    case 'base64':
+      return base64ToBytes(value).buffer as ArrayBuffer;
+    default:
+      return new TextEncoder().encode(value).buffer as ArrayBuffer;
+  }
+};
+
+const errorDetail = (body: unknown, template: TTSRequestTemplate, raw: string): string => {
+  const fromPath = template.errorPath ? getByPath(body, template.errorPath) : undefined;
+  if (typeof fromPath === 'string' && fromPath) return fromPath;
+  if (typeof body === 'string' && body) return body.slice(0, 300);
+  if (body && typeof body === 'object') return JSON.stringify(body).slice(0, 300);
+  return raw.slice(0, 300);
+};
+
+const throwStatusError = (
+  service: CustomTTSService,
+  status: number,
+  raw: string,
+  parsed: unknown,
+  template: TTSRequestTemplate,
+): never => {
+  const detail = errorDetail(parsed ?? raw, template, raw);
+  const message = `${service.name}: HTTP ${status}${detail ? ` ${detail}` : ''}`;
+  if (status === 401 || status === 403) throw new SpeechSynthesisFatalError(message);
+  if (status < 500 && status !== 429) throw new SpeechSynthesisPermanentError(message);
+  throw new Error(message);
+};
+
+export const buildTemplateRequest = (
+  service: CustomTTSService,
+  req: SpeechSynthesisRequest,
+  ctx: TemplateContext,
+) => {
+  const template = service.request;
+  if (!template) throw new SpeechSynthesisFatalError(`${service.name}: no request template`);
+  // The service owns its own endpoint and key: deriving them here means a
+  // caller cannot render a request against the wrong host.
+  const context: TemplateContext = {
+    ...ctx,
+    baseUrl: service.baseUrl,
+    apiKey: service.apiKey ?? '',
+  };
+  const url = renderTemplate(template.url, context, 'url');
+  const headers: Record<string, string> = {};
+  for (const [key, value] of Object.entries(template.headers ?? {})) {
+    if (value) headers[key] = renderTemplate(value, context, 'raw');
+  }
+  let body: string | undefined;
+  if (template.method !== 'GET' && template.body) {
+    const mode = template.bodyType === 'json' ? 'json' : 'raw';
+    body = renderTemplate(template.body, { ...context, text: req.text }, mode);
+    if (template.bodyType === 'form' && !headers['Content-Type']) {
+      headers['Content-Type'] = 'application/x-www-form-urlencoded';
+    }
+    if (template.bodyType === 'json' && !headers['Content-Type']) {
+      headers['Content-Type'] = 'application/json';
+    }
+  }
+  return { url, headers, body };
+};
+
+/** Speak one sentence through a user template. */
+export const synthesizeWithTemplate = async (
+  service: CustomTTSService,
+  req: SpeechSynthesisRequest,
+  signal: AbortSignal,
+): Promise<ArrayBuffer> => {
+  const template = service.request;
+  if (!template) throw new SpeechSynthesisFatalError(`${service.name}: no request template`);
+
+  const ctx: TemplateContext = {
+    text: req.text,
+    voice: req.voice ?? '',
+    lang: req.lang ?? '',
+    rate: 1,
+    pitch: req.pitch ?? 1,
+    format: 'mp3',
+    apiKey: service.apiKey ?? '',
+    baseUrl: service.baseUrl,
+  };
+
+  const { url, headers, body } = buildTemplateRequest(service, req, ctx);
+  const res = await getAIFetch()(url, {
+    method: template.method,
+    headers,
+    ...(body !== undefined ? { body } : {}),
+    signal,
+  });
+
+  // Binary answers must never pass through a string: read the bytes directly.
+  if (template.responseType === 'audio') {
+    if (!res.ok) {
+      const raw = await res.text().catch(() => '');
+      throwStatusError(service, res.status, raw, undefined, template);
+    }
+    return await res.arrayBuffer();
+  }
+
+  const raw = await res.text();
+  if (!res.ok) {
+    let parsed: unknown = raw;
+    try {
+      parsed = JSON.parse(raw);
+    } catch {
+      // Not JSON: the text is the detail.
+    }
+    throwStatusError(service, res.status, raw, parsed, template);
+  }
+
+  let json: unknown;
+  try {
+    json = JSON.parse(raw);
+  } catch {
+    throw new SpeechSynthesisPermanentError(
+      `${service.name}: expected JSON, got ${raw.slice(0, 120)}`,
+    );
+  }
+
+  // Vendors such as MiniMax report failure inside a 200 response.
+  if (template.successPath) {
+    const actual = String(getByPath(json, template.successPath) ?? '');
+    const wanted = template.successValue ?? '';
+    if (actual !== wanted) {
+      throw new SpeechSynthesisPermanentError(
+        `${service.name}: ${errorDetail(json, template, raw)}`,
+      );
+    }
+  }
+
+  const audioValue = getByPath(json, template.audioPath ?? '');
+  if (typeof audioValue !== 'string' || !audioValue) {
+    throw new SpeechSynthesisPermanentError(
+      `${service.name}: no audio at ${template.audioPath || '(unset audioPath)'}`,
+    );
+  }
+  return bytesOf(audioValue, template.audioEncoding);
+};
